# Local development. Copy to .env and adjust.
# PostgreSQL. Locally: `docker compose up -d` (docker-compose.yml) starts one with these
# credentials. On a server, use the database server's address and a real password.
DATABASE_URL="postgresql://mypage:mypage@localhost:5433/mypage?schema=public"

# Signs session cookies. Must be a long random string in any shared environment.
AUTH_SECRET="dev-only-change-me-in-production-0000000000"

# Private media root. Originals are never served from /public.
STORAGE_DIR="./storage"

# Verifies payment webhooks. The mock provider signs with HMAC-SHA256.
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Subdomain shown in the editor. Doc 01: format still to be confirmed with the owner.
PAGE_DOMAIN="muska.cv"
