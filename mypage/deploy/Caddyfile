# HTTPS for My Page. Caddy gets and renews the Let's Encrypt certificate on its
# own; the domain's DNS must already point at this server (ports 80 and 443 open).
{$SITE_DOMAIN} {
	encode zstd gzip
	# Uploads go through the app, which caps files at 100 MB (MAX_UPLOAD_BYTES).
	request_body {
		max_size 200MB
	}
	reverse_proxy web:3000
}
