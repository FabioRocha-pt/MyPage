# Backend server (database + API), for docker-compose.backend.yml.
# Copy to .env.backend on the server and fill in every "change-me".

# PostgreSQL (the postgres container). DATABASE_URL is built from these in the
# compose file. Generate the password with: openssl rand -hex 24
POSTGRES_USER="mypage"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="mypage"

# Where the API listens: this server's address on the Hetzner private network
# (e.g. 10.0.0.2), so only the frontend server reaches it. Never 0.0.0.0.
API_BIND="10.0.0.2"
API_PORT="3000"

# Shared with the frontend (.env.frontend): proves page-data requests come from
# it. Same value on both servers. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET="change-me"

# Signs session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Subdomain shown in the editor. Doc 01: format still to be confirmed with the owner.
PAGE_DOMAIN="muska.cv"

# Payments. "mock" until the SISP contract exists; the mock endpoint stays off
# unless ALLOW_MOCK_PAYMENTS="1".
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="change-me"
ALLOW_MOCK_PAYMENTS="0"

# Muska API and SSO: filled in once the Muska team provides them.
# MUSKA_API_URL=""
# MUSKA_API_KEY=""
