# Frontend server (public pages + studio), for docker-compose.frontend.yml.
# Copy to .env.frontend on the server and fill in every "change-me".

# The backend's API on the private network: API_BIND and API_PORT of .env.backend.
API_URL="http://10.0.0.2:3000"

# Same value as INTERNAL_API_SECRET in .env.backend.
INTERNAL_API_SECRET="change-me"

# Public address of the site. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_SITE_URL="https://mypage.cv"
# Domain for the optional Caddy container (--profile proxy).
SITE_DOMAIN="mypage.cv"
# Host port the web container listens on (loopback only), for an nginx already on the server.
WEB_PORT="3000"

# Read by the studio screens; keep equal to .env.backend.
PAGE_DOMAIN="muska.cv"
PAYMENT_PROVIDER="mock"
